# ============================================================
# PostureTrek Backend — environment variable template
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file.
# ============================================================

# ── Flask ────────────────────────────────────────────────────
FLASK_ENV=development        # set to 'production' to harden secrets & disable debug
FLASK_DEBUG=false            # set to 'true' only during local development

# ── Security (REQUIRED in production) ───────────────────────
# Generate strong random values with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-a-different-random-secret

# ── CORS (comma-separated allowed origins) ──────────────────
# Default covers local dev. Override in production.
# CORS_ORIGINS=https://your-frontend-domain.com

# ── Database ─────────────────────────────────────────────────
# Defaults to SQLite inside backend/instance/ if not set.
# SQLALCHEMY_DATABASE_URI=postgresql://user:pass@localhost/postretrek

# ── AI Providers (both optional — app works without them) ────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:latest
# GEMINI_API_KEY=your-gemini-api-key-here
